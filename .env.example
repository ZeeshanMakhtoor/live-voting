# Supabase project (Settings -> API)
# Both are required, in every environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hostname (no protocol, include the port in local dev) that routes to the
# admin app, e.g. admin.example.com. Required in production: if it doesn't
# match the real admin subdomain, the admin app is only reachable at
# /admin/* on the public domain.
# Locally, use admin.localhost:3000 and add it to your hosts file, or just
# visit /admin directly — middleware falls back to path-based routing when
# the configured admin host isn't matched.
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000

# OPTIONAL, server-only, and not needed to run the app. The service role
# key bypasses RLS entirely. Nothing in the request path uses it; it exists
# only for one-off trusted server scripts (e.g. bootstrapping the admin
# account). Never prefix it with NEXT_PUBLIC_ and never set it in a client
# context. Leave it unset unless a script you are running needs it.
SUPABASE_SERVICE_ROLE_KEY=
