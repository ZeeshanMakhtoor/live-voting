# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used solely for trusted server-side admin operations
# that must bypass RLS (e.g. one-time admin bootstrap scripts).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for the audience app, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname (no protocol) that routes to the admin app, e.g. admin.example.com
# In local dev, use admin.localhost:3000 and add it to your hosts file,
# or visit /admin directly (middleware falls back to path-based routing
# when the configured admin host isn't matched).
NEXT_PUBLIC_ADMIN_HOST=admin.localhost:3000
